@using CLDV7112_PROJECT2.Models
@{
    ViewData["Title"] = "Azure Serverless Functions & Enterprise Cloud Monitor";
    var logs = ViewBag.Logs as List<LogEntry> ?? new List<LogEntry>();
}

<div class="container-fluid py-3">
    <!-- Header Banner -->
    <div class="glass-panel p-4 mb-4 border-left-primary">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="h3 fw-bold text-gradient mb-1">
                    <i class="bi bi-cpu-fill me-2"></i>Azure Serverless Microservices & Event Audit Monitor
                </h1>
                <p class="text-white-50 mb-0 small">
                    Real-time automated execution monitor for background Azure Functions, Storage Queues, Blobs, Tables, Azure Files, Event Hubs, and Service Bus.
                </p>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <span class="badge bg-success px-3 py-2 text-uppercase">
                    <i class="bi bi-check-circle-fill me-1"></i>Azure Functions Online
                </span>
                <span class="badge bg-dark border border-secondary px-3 py-2">
                    <code>func-cldv7112-project2</code>
                </span>
            </div>
        </div>
    </div>

    <!-- Invisible Architecture Explanation Banner -->
    <div class="glass-panel p-4 mb-4 border-left-info shadow-sm">
        <h5 class="fw-bold text-white mb-2">
            <i class="bi bi-eye-slash-fill me-2 text-info"></i>How Invisible Serverless Azure Functions Work in ABC Retail
        </h5>
        <p class="text-white-50 small mb-0">
            To website visitors, Azure Functions are completely invisible—they are not visual buttons or layouts on the screen. Instead, Azure Functions act as the hidden, behind-the-scenes engine that powers dynamic website features. When visitors register, upload media, or complete a checkout, the front-end code sends an invisible HTTP request to the Function URL. The function executes instantly, processes the cloud storage operation, and logs the result below automatically without requiring any manual admin intervention.
        </p>
    </div>

    <!-- Everyday Feature Microservices Architecture Grid -->
    <div class="row g-4 mb-4">
        
        <!-- 1. CUSTOMER SIGNUP -->
        <div class="col-md-6 col-lg-3">
            <div class="glass-panel p-3 h-100 border-left-primary">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-primary bg-opacity-25 p-2 me-2">
                        <i class="bi bi-person-check-fill text-primary fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-white mb-0">Customer Signup</h6>
                        <small class="text-white-50">`StoreTableInfo` Function</small>
                    </div>
                </div>
                <p class="text-white-50 extra-small mb-2">
                    When a visitor fills out the registration form, the site invisibly pings <code>/api/StoreTableInfo</code> to save customer profile data to <strong>Azure Table Storage</strong>.
                </p>
                <span class="badge bg-dark border border-secondary text-primary">Target: Azure Tables</span>
            </div>
        </div>

        <!-- 2. PRODUCT ASSET UPLOADS -->
        <div class="col-md-6 col-lg-3">
            <div class="glass-panel p-3 h-100 border-left-success">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-success bg-opacity-25 p-2 me-2">
                        <i class="bi bi-cloud-arrow-up-fill text-success fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-white mb-0">Media Asset Uploads</h6>
                        <small class="text-white-50">`UploadBlob` Function</small>
                    </div>
                </div>
                <p class="text-white-50 extra-small mb-2">
                    When an image or file is uploaded, the site invisibly pings <code>/api/UploadBlob</code> to upload file streams directly to <strong>Azure Blob Storage</strong>.
                </p>
                <span class="badge bg-dark border border-secondary text-success">Target: Azure Blobs</span>
            </div>
        </div>

        <!-- 3. ORDER CHECKOUT QUEUES -->
        <div class="col-md-6 col-lg-3">
            <div class="glass-panel p-3 h-100 border-left-warning">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-warning bg-opacity-25 p-2 me-2">
                        <i class="bi bi-cart-check-fill text-warning fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-white mb-0">Checkout Processing</h6>
                        <small class="text-white-50">`WriteQueueTransaction`</small>
                    </div>
                </div>
                <p class="text-white-50 extra-small mb-2">
                    When a purchase is made, the transaction is pushed invisibly to <strong>Azure Queue Storage</strong> and invoice documents are archived to <strong>Azure File Share</strong>.
                </p>
                <span class="badge bg-dark border border-secondary text-warning">Target: Azure Queue & Files</span>
            </div>
        </div>

        <!-- 4. TELEMETRY & PUB/SUB -->
        <div class="col-md-6 col-lg-3">
            <div class="glass-panel p-3 h-100 border-left-info">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-info bg-opacity-25 p-2 me-2">
                        <i class="bi bi-broadcast text-info fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-white mb-0">Telemetry & Messaging</h6>
                        <small class="text-white-50">Event Hubs & Service Bus</small>
                    </div>
                </div>
                <p class="text-white-50 extra-small mb-2">
                    Clickstream user activity streams to <strong>Azure Event Hubs</strong>, and order status updates publish to <strong>Azure Service Bus</strong> topics automatically.
                </p>
                <span class="badge bg-dark border border-secondary text-info">Target: Event Hubs & Bus</span>
            </div>
        </div>

    </div>

    <!-- Live Automated Execution Log Audit Stream (100% Automated — No Buttons Required) -->
    <div class="glass-panel p-4 border-left-success shadow-lg">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h5 class="fw-bold text-white mb-0">
                    <i class="bi bi-terminal-fill me-2 text-success"></i>Automated Live Function Execution Audit Log
                </h5>
                <p class="text-white-50 small mb-0">
                    This log automatically records background Azure Function triggers as visitors use the website. No manual button clicks are needed.
                </p>
            </div>
            <span class="badge bg-success px-3 py-2 text-uppercase">
                <i class="bi bi-arrow-repeat me-1"></i>Auto-Synchronised
            </span>
        </div>

        @if (logs.Count == 0)
        {
            <div class="alert alert-dark border border-secondary text-white-50 text-center py-4 my-2">
                <i class="bi bi-info-circle fs-3 text-info d-block mb-2"></i>
                <p class="mb-1 fw-bold text-white">No Function Execution Logs Recorded Yet</p>
                <small>Perform an action on the storefront (e.g. register a customer profile on <code>/Home/Register</code> or place an order) to see background Azure Function triggers recorded here automatically.</small>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0 border border-secondary rounded">
                    <thead class="table-dark text-uppercase small text-white-50">
                        <tr>
                            <th scope="col" style="width: 180px;"><i class="bi bi-clock me-1"></i>Timestamp</th>
                            <th scope="col" style="width: 120px;"><i class="bi bi-shield-check me-1"></i>Status</th>
                            <th scope="col"><i class="bi bi-cpu me-1"></i>Automatic Execution Log Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in logs)
                        {
                            <tr>
                                <td class="text-white-50 small font-monospace">@log.Timestamp</td>
                                <td>
                                    @if (log.Level.ToUpper() == "ERROR")
                                    {
                                        <span class="badge bg-danger">@log.Level</span>
                                    }
                                    else if (log.Level.ToUpper() == "WARNING")
                                    {
                                        <span class="badge bg-warning text-dark">@log.Level</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">HTTP 200 OK</span>
                                    }
                                </td>
                                <td class="text-white small font-monospace">
                                    @log.Message
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
