@model IEnumerable<CLDV7112_PROJECT2.Models.Product>
@{
    ViewData["Title"] = "Manage Inventory";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold mb-1"><span class="text-gradient">Product Inventory</span></h1>
        <p class="text-white-50">Manage items stored in Azure Tables. Product images are uploaded and hosted in Azure Blob Containers.</p>
    </div>
    <div class="col-md-4 text-md-end">
        <a asp-action="AddProduct" class="btn btn-rainbow">
            <i class="bi bi-plus-circle-fill me-2"></i>Add New Product
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 glass-panel mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 glass-panel mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}

<div class="glass-panel p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-box-seam display-3 text-muted mb-3"></i>
            <h5 class="fw-semibold text-white">No products found</h5>
            <p class="text-white-50">Click "Add New Product" to start building your catalog.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th style="width: 80px;">Image</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th class="text-center">Stock Level</th>
                        <th class="text-end">Price</th>
                        <th class="text-center" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var stock = item.StockQuantity > 0 ? item.StockQuantity : 50;
                        <tr>
                            <td>
                                <div class="rounded border border-secondary overflow-hidden bg-dark d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image text-muted fs-4"></i>
                                    }
                                </div>
                            </td>
                            <td>
                                <strong class="text-white">@item.Name</strong>
                                <span class="d-block text-white-50 small">ID: @item.RowKey.Substring(0, 8)...</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.Category</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success">@stock units</span>
                            </td>
                            <td class="text-end fw-bold text-price">
                                R@(item.Price.ToString("F2"))
                            </td>
                            <td class="text-center">
                                <form asp-action="DeleteProduct" method="post" onsubmit="return confirm('Are you sure you want to delete this product and its associated blob image?');">
                                    <input type="hidden" name="rowKey" value="@item.RowKey" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash3-fill"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
