@model IEnumerable<CLDV7112_PROJECT2.Models.LogEntry>
@{
    ViewData["Title"] = "System Logs - ABC Retail";
    var activeFile = ViewBag.ActiveFile as string ?? "system-logs.txt";
    var logFiles = ViewBag.LogFileNames as string[];
    var displayNames = new Dictionary<string, string>
    {
        { "system-logs.txt", "System Logs" },
        { "order-logs.txt", "Order Logs" },
        { "product-logs.txt", "Product Logs" },
        { "customer-logs.txt", "Customer Logs" },
        { "error-logs.txt", "Error Logs" }
    };
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-gradient mb-1">
                <i class="bi bi-terminal-fill me-2"></i>System & Storage Audit Logs
            </h2>
            <p class="text-white-50 mb-0">Logs stored in Azure File Share (<code>contracts</code>). Select a file to inspect operations.</p>
        </div>
        <form asp-action="ClearLogs" method="post" class="d-inline">
            <input type="hidden" name="file" value="@activeFile" />
            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Clear log file @activeFile?')">
                <i class="bi bi-trash3 me-1"></i>Clear Log
            </button>
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 glass-panel mb-4">@TempData["Success"]</div>
    }

    <!-- Log File Tabs -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        @foreach (var file in logFiles ?? Array.Empty<string>())
        {
            var isActive = file == activeFile;
            var display = displayNames.ContainsKey(file) ? displayNames[file] : file;
            var icon = file switch
            {
                "order-logs.txt" => "bi-receipt",
                "product-logs.txt" => "bi-box-seam",
                "customer-logs.txt" => "bi-person",
                "error-logs.txt" => "bi-exclamation-triangle",
                _ => "bi-terminal"
            };
            <a href="@Url.Action("Logs", new { file })"
               class="btn @(isActive ? "btn-rainbow" : "btn-glass") btn-sm">
                <i class="bi @icon me-1"></i>@display
            </a>
        }
    </div>

    <!-- Terminal Window -->
    <div class="terminal-window">
        <div class="terminal-header d-flex justify-content-between">
            <div>
                <span class="terminal-dot dot-red"></span>
                <span class="terminal-dot dot-yellow"></span>
                <span class="terminal-dot dot-green"></span>
                <span class="text-white-50 small ms-2">@activeFile</span>
            </div>
            <span class="text-white-50 small">@Model.Count() entries</span>
        </div>
        <div class="terminal-body">
            @if (!Model.Any())
            {
                <span class="text-muted">// Log file is empty or has not received any events yet.</span>
            }
            else
            {
                @foreach (var entry in Model)
                {
                    var css = entry.Level.ToUpper() switch
                    {
                        "ERROR" => "log-error",
                        "WARNING" => "log-warning",
                        _ => "log-info"
                    };
                    <div class="mb-1">
                        <span class="log-timestamp">[@entry.Timestamp]</span>
                        <span class="@css fw-semibold"> [@entry.Level]</span>
                        <span class="text-white"> @entry.Message</span>
                    </div>
                }
            }
        </div>
    </div>
</div>
