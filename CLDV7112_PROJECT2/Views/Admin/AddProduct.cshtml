@model CLDV7112_PROJECT2.Models.Product
@{
    ViewData["Title"] = "Add Inventory Item";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="glass-panel p-5">
            <div class="mb-4">
                <a asp-action="Products" class="text-info text-decoration-none small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Inventory
                </a>
            </div>

            <div class="text-center mb-4">
                <i class="bi bi-box-seam display-4 text-gradient"></i>
                <h2 class="fw-bold mt-2">Add New Product</h2>
                <p class="text-white-50 small">Upload image to Azure Blob and save product metadata to Azure Table.</p>
            </div>

            <form asp-action="AddProduct" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="label-custom">Product Name</label>
                    <input asp-for="Name" class="form-control form-glass" placeholder="e.g. Christmas Woolen Sweater" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="label-custom">Category</label>
                        <select asp-for="Category" class="form-select form-glass" required>
                            <option value="" disabled selected>Select Category</option>
                            <option value="Clothing">Clothing</option>
                            <option value="Electronics">Electronics</option>
                            <option value="Home & Living">Home & Living</option>
                            <option value="Toys & Hobbies">Toys & Hobbies</option>
                            <option value="Gifts">Gifts</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="label-custom">Retail Price (ZAR)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control form-glass" placeholder="e.g. 299.99" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="StockQuantity" class="label-custom">Stock Quantity</label>
                    <input asp-for="StockQuantity" type="number" min="0" class="form-control form-glass" placeholder="e.g. 50" required />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    <small class="text-white-50 d-block mt-1"><i class="bi bi-info-circle me-1"></i>Stock is automatically decremented when customers place paid orders.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="label-custom">Description <small class="text-white-50">(optional)</small></label>
                    <textarea asp-for="Description" class="form-control form-glass" rows="3" placeholder="Briefly describe the product..."></textarea>
                </div>

                <div class="mb-4">
                    <label class="label-custom" for="imageFile">Product Image (Upload to Azure Blob Storage)</label>
                    <input type="file" id="imageFile" name="imageFile" class="form-control form-glass" accept="image/*" required />
                    <span class="text-white-50 small mt-1 d-block"><i class="bi bi-cloud-arrow-up me-1"></i>Uploads to <code>product-images</code> container. Supports JPG, PNG, GIF, WEBP.</span>
                </div>

                <button type="submit" class="btn btn-rainbow w-100 py-2.5">
                    <i class="bi bi-cloud-arrow-up-fill me-2"></i>Upload Product & Image
                </button>
            </form>
        </div>
    </div>
</div>
