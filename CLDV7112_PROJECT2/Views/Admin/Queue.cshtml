@model IEnumerable<CLDV7112_PROJECT2.Models.QueueMessageModel>
@{
    ViewData["Title"] = "Order Queue Management";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold mb-1"><span class="text-gradient">Asynchronous Order Queue</span></h1>
        <p class="text-white-50">View and process messages queued in Azure Queue Storage (<code>order-processing-queue</code>).</p>
    </div>
    <div class="col-md-4 text-md-end d-flex gap-2 justify-content-md-end">
        <form asp-action="ProcessQueueMessage" method="post">
            <button type="submit" class="btn btn-rainbow">
                <i class="bi bi-gear-wide-connected me-2"></i>Process Next Message
            </button>
        </form>
        <form asp-action="ClearQueue" method="post" onsubmit="return confirm('Are you sure you want to purge all messages in the queue?');">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash3-fill me-2"></i>Purge Queue
            </button>
        </form>
    </div>
</div>

@if (TempData["ProcessSuccess"] != null)
{
    <div class="alert alert-info bg-info border-0 text-white alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>@TempData["ProcessSuccess"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-12">
        <div class="terminal-window">
            <div class="terminal-header">
                <span class="terminal-dot dot-red"></span>
                <span class="terminal-dot dot-yellow"></span>
                <span class="terminal-dot dot-green"></span>
                <span class="text-white-50 ms-3 small">Queue Console (Peek View) - @Model.Count() Messages In Queue</span>
            </div>
            <div class="terminal-body" style="background-color: #0b0f19;">
                @if (!Model.Any())
                {
                    <div class="text-center py-4 text-white-50">
                        <i class="bi bi-chat-left-dots fs-1 d-block mb-2 text-muted"></i>
                        <span>Queue is empty. No messages are currently waiting for execution.</span>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-custom mb-0">
                            <thead>
                                <tr>
                                    <th>Timestamp</th>
                                    <th>Message Content</th>
                                    <th>Message ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var msg in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="log-timestamp">@msg.InsertionTime?.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                        </td>
                                        <td>
                                            <span class="text-warning"><i class="bi bi-arrow-right-short me-1"></i> @msg.MessageText</span>
                                        </td>
                                        <td>
                                            <code class="text-white-50">@msg.MessageId</code>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
