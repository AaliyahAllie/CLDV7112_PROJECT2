@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using System.Text.Json
@{
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
    var cartJson = HttpContextAccessor.HttpContext?.Session.GetString("Cart");
    var cartCount = 0;
    if (!string.IsNullOrEmpty(cartJson))
    {
        try
        {
            var cartItems = JsonSerializer.Deserialize<List<CLDV7112_PROJECT2.Models.CartItem>>(cartJson);
            cartCount = cartItems?.Sum(x => x.Quantity) ?? 0;
        }
        catch { }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Retail</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-glass fixed-top">
            <div class="container">
                <a class="navbar-brand navbar-brand-glow" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-seam-fill me-2"></i>ABC RETAIL
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (string.IsNullOrEmpty(userRole))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door-fill me-1"></i>Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="About">
                                    <i class="bi bi-info-circle-fill me-1"></i>About & Services
                                </a>
                            </li>
                        }
                        else if (userRole == "Customer")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Customer" asp-action="Index">
                                    <i class="bi bi-grid-fill me-1"></i>Shop Products
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Customer" asp-action="MyOrders">
                                    <i class="bi bi-bag-check-fill me-1"></i>My Orders
                                </a>
                            </li>
                        }
                        else if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Products">
                                    <i class="bi bi-box-seam me-1"></i>Inventory
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Orders">
                                    <i class="bi bi-receipt me-1"></i>Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Customers">
                                    <i class="bi bi-people-fill me-1"></i>Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-nowrap" asp-controller="Admin" asp-action="Queue">
                                    <i class="bi bi-envelope-paper-fill me-1"></i>Order Queue
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-warning font-weight-bold text-nowrap" asp-controller="Functions" asp-action="Index">
                                    <i class="bi bi-cpu-fill me-1"></i>Azure Functions
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-nowrap" asp-controller="Admin" asp-action="Logs">
                                    <i class="bi bi-terminal-fill me-1"></i>System Logs
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(userRole))
                        {
                            @if (userRole == "Customer")
                            {
                                <a asp-controller="Cart" asp-action="Index" class="btn btn-glass btn-sm me-2 position-relative">
                                    <i class="bi bi-cart3"></i>
                                    @if (cartCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.65rem;">@cartCount</span>
                                    }
                                </a>
                            }
                            <span class="text-white-50 me-3 text-nowrap">
                                <i class="bi bi-person-circle me-1"></i>Hello, <strong>@userName</strong>
                                <span class="badge bg-secondary ms-1">@userRole</span>
                            </span>
                            <a class="btn btn-sm btn-glass text-nowrap" asp-controller="Home" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i>Sign Out
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-glass me-2 text-nowrap" asp-controller="Home" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                            <a class="btn btn-sm btn-rainbow text-nowrap" asp-controller="Home" asp-action="Register">
                                <i class="bi bi-person-plus-fill me-1"></i>Sign Up
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-container" style="padding-top: 8rem; margin-top: 1rem;">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-glass mt-auto">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-2 mb-md-0">
                    <span>&copy; 2026 - <strong>ABC Retail Inc.</strong> Cloud Processing Solutions.</span>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="text-white-50"><i class="bi bi-shield-lock me-1"></i>Secured via Azure Storage Services</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
