@{
    ViewData["Title"] = "About ABC Retail & Services";
}

<div class="glass-panel p-5 mt-4">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <h1 class="display-5 fw-bold mb-4"><span class="text-gradient">About ABC Retail</span></h1>
            <p class="lead text-white">
                ABC Retail is a premier, fast-growing global online merchant delivering top-tier consumer products directly to your doorstep.
            </p>
            <p class="text-white-50">
                Facing challenges with outdated, slow, and unreliable on-premises systems, we migrated our entire e-commerce workload to Microsoft Azure. Our services leverage highly reliable Azure cloud storage components to handle large transaction spikes during holidays like Christmas, maintain persistent catalog synchronization, and offer real-time order auditing transparently.
            </p>

            <h3 class="mt-4 mb-3 fw-semibold">Our Services</h3>
            <ul class="list-unstyled">
                <li class="mb-3 d-flex align-items-start">
                    <span class="fs-4 text-info me-3"><i class="bi bi-truck"></i></span>
                    <div>
                        <strong class="d-block text-white">Express Order Fulfilment</strong>
                        <span class="text-white-50">Asynchronous order queues process delivery logs and coordinate warehouses in real-time.</span>
                    </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                    <span class="fs-4 text-primary me-3"><i class="bi bi-shield-check"></i></span>
                    <div>
                        <strong class="d-block text-white">Secured Customer Profiles</strong>
                        <span class="text-white-50">Your contact info and profiles are partitioned and protected by enterprise security filters.</span>
                    </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                    <span class="fs-4 text-warning me-3"><i class="bi bi-lightning-charge"></i></span>
                    <div>
                        <strong class="d-block text-white">High-Speed Image Delivery</strong>
                        <span class="text-white-50">Global Blob distribution nodes deliver high-quality media content instantly, preventing load-time delays.</span>
                    </div>
                </li>
            </ul>
        </div>
        <div class="col-lg-5 text-center d-none d-lg-block">
            <div class="p-4 glass-panel border-secondary shadow-lg">
                <i class="bi bi-buildings-fill display-1 text-gradient"></i>
                <div class="mt-4">
                    <h5 class="fw-bold">ABC Retail Headquarters</h5>
                    <p class="text-white-50 small mb-0">Seattle, WA & Global Fulfillment Hubs</p>
                </div>
            </div>
        </div>
    </div>
</div>
