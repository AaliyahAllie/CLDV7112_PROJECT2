@{
    ViewData["Title"] = "Order Confirmed";
    var productName = ViewBag.ProductName as string;
    var imageUrl = ViewBag.ImageUrl as string;
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="glass-panel p-5">
            <div class="text-success display-1 mb-4">
                <i class="bi bi-patch-check-fill"></i>
            </div>
            
            <h1 class="fw-bold text-gradient mb-3">Order Confirmed!</h1>
            <p class="text-white mb-4">
                Your order has been queued for execution. The inventory and packing departments have been notified.
            </p>

            <div class="glass-panel p-4 mb-4 bg-dark text-start d-flex align-items-center gap-3">
                <div class="product-img-wrapper rounded border border-secondary" style="width: 80px; padding-top: 80px; flex-shrink: 0;">
                    @if (!string.IsNullOrEmpty(imageUrl))
                    {
                        <img src="@imageUrl" alt="@productName" class="product-img" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center h-100 bg-secondary text-white">
                            <i class="bi bi-box-seam fs-4"></i>
                        </div>
                    }
                </div>
                <div>
                    <h5 class="fw-bold text-white mb-1">@productName</h5>
                    <span class="badge bg-success">Status: Queued</span>
                </div>
            </div>

            <div class="text-white-50 small mb-4 text-start p-3 bg-dark border border-secondary rounded">
                <strong class="text-white d-block mb-1"><i class="bi bi-cpu-fill me-1"></i>Azure Cloud Event Details:</strong>
                <ul class="mb-0 ps-3">
                    <li>Message sent to <code class="text-info">order-processing-queue</code></li>
                    <li>Audit entry written to <code class="text-info">abc-retail-logs.txt</code> in File Share</li>
                    <li>Transaction registered in Table Storage</li>
                </ul>
            </div>

            <a asp-action="Index" class="btn btn-rainbow w-100 py-2">
                <i class="bi bi-arrow-left me-2"></i>Continue Shopping
            </a>
        </div>
    </div>
</div>
