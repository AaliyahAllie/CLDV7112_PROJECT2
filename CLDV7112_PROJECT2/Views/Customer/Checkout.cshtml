@model IEnumerable<CLDV7112_PROJECT2.Models.CartItem>
@{
    ViewData["Title"] = "Checkout - ABC Retail";
    decimal total = ViewBag.TotalAmount != null ? Convert.ToDecimal(ViewBag.TotalAmount) : Convert.ToDecimal(Model.Sum(x => x.LineTotal));
    var isDemo = ViewBag.IsDemoPayment == true;
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-gradient mb-1">
            <i class="bi bi-shield-lock-fill me-2"></i>Secure Checkout
        </h2>
        <p class="text-white-50">Complete your order below. Payments and transactions are processed securely via Stripe and Azure Microservices.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger glass-panel mb-4 text-white border-left-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="glass-panel p-4 mb-4 border-left-primary">
                <h4 class="fw-bold text-white mb-3">
                    <i class="bi bi-credit-card-2-front-fill me-2 text-primary"></i>Payment Details
                </h4>

                <form id="payment-form" asp-action="ConfirmPayment" method="post">
                    <input type="hidden" id="paymentIntentId" name="paymentIntentId" value="@ViewBag.ClientSecret" />

                    @if (!isDemo)
                    {
                        <div class="mb-3">
                            <label class="form-label label-custom">Card Details</label>
                            <div id="card-element" class="p-3 bg-dark rounded border border-secondary"></div>
                            <div id="card-errors" class="text-danger small mt-2" role="alert"></div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 bg-dark rounded border border-secondary mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary"><i class="bi bi-shield-check me-1"></i>Secure Payment Gateway</span>
                                <small class="text-white-50">256-Bit SSL Encrypted</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small text-white-50">Cardholder Name</label>
                                <input type="text" class="form-control form-glass form-control-sm" value="Aaliyah Allie" required />
                            </div>
                            <div class="row g-2">
                                <div class="col-7">
                                    <label class="form-label small text-white-50">Card Number</label>
                                    <input type="text" class="form-control form-glass form-control-sm" value="4242 4242 4242 4242" required />
                                </div>
                                <div class="col-3">
                                    <label class="form-label small text-white-50">Expires</label>
                                    <input type="text" class="form-control form-glass form-control-sm" value="12/28" required />
                                </div>
                                <div class="col-2">
                                    <label class="form-label small text-white-50">CVC</label>
                                    <input type="text" class="form-control form-glass form-control-sm" value="888" required />
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mb-4">
                        <small class="text-white-50">
                            <i class="bi bi-info-circle me-1"></i>
                            Your payment is encrypted and processed securely by <strong>Stripe & Azure Serverless Functions</strong>.
                        </small>
                    </div>

                    <button id="pay-btn" type="submit" class="btn btn-rainbow w-100 py-3 fs-5 fw-bold">
                        <i class="bi bi-lock-fill me-2"></i>Pay R@(total.ToString("F2")) Now
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="glass-panel p-4 border-left-info">
                <h4 class="fw-bold text-white mb-3">
                    <i class="bi bi-bag-check-fill me-2 text-info"></i>Order Summary
                </h4>

                <div class="mb-3" style="max-height: 280px; overflow-y: auto;">
                    @foreach (var item in Model)
                    {
                        <div class="d-flex align-items-center justify-content-between p-2 mb-2 bg-dark bg-opacity-50 rounded border border-secondary">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 42px; height: 42px; object-fit: cover; border-radius: 8px;" />
                                }
                                else
                                {
                                    <div class="bg-secondary rounded d-flex align-items-center justify-content-center text-white fw-bold" style="width: 42px; height: 42px;">
                                        @item.ProductName.Substring(0, 1)
                                    </div>
                                }
                                <div>
                                    <strong class="text-white d-block small">@item.ProductName</strong>
                                    <small class="text-white-50 extra-small">Qty: @item.Quantity x R@(item.Price.ToString("F2"))</small>
                                </div>
                            </div>
                            <span class="fw-bold text-price small">R@(item.LineTotal.ToString("F2"))</span>
                        </div>
                    }
                </div>

                <hr class="border-secondary my-3" />

                <div class="d-flex justify-content-between mb-2 text-white-50 small">
                    <span>Subtotal</span>
                    <span>R@(total.ToString("F2"))</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-white-50 small">
                    <span>Shipping & Handling</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>
                <hr class="border-secondary my-3" />
                <div class="d-flex justify-content-between mb-3 fs-5 fw-bold text-white">
                    <span>Total Due</span>
                    <span class="text-price">R@(total.ToString("F2"))</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        const isDemo = @(isDemo ? "true" : "false");
        const form = document.getElementById("payment-form");
        const payBtn = document.getElementById("pay-btn");

        if (!isDemo && typeof Stripe !== "undefined") {
            try {
                const stripe = Stripe("@ViewBag.PublishableKey");
                const elements = stripe.elements();
                const cardElement = elements.create("card", {
                    style: {
                        base: {
                            color: "#f8fafc",
                            fontFamily: "Outfit, sans-serif",
                            fontSmoothing: "antialiased",
                            fontSize: "16px",
                            "::placeholder": { color: "#94a3b8" }
                        },
                        invalid: { color: "#ff4081", iconColor: "#ff4081" }
                    }
                });
                cardElement.mount("#card-element");

                form.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    payBtn.disabled = true;
                    payBtn.innerHTML = "<span class=\"spinner-border spinner-border-sm me-2\"></span>Processing Payment...";

                    const { paymentIntent, error } = await stripe.confirmCardPayment("@ViewBag.ClientSecret", {
                        payment_method: { card: cardElement }
                    });

                    if (error) {
                        document.getElementById("card-errors").textContent = error.message;
                        payBtn.disabled = false;
                        payBtn.innerHTML = "<i class=\"bi bi-lock-fill me-2\"></i>Pay R@(total.ToString("F2")) Now";
                    } else if (paymentIntent && paymentIntent.status === "succeeded") {
                        document.getElementById("paymentIntentId").value = paymentIntent.id;
                        form.submit();
                    }
                });
            } catch (err) {
                console.warn("Stripe init fallback:", err);
            }
        }
    </script>
}
