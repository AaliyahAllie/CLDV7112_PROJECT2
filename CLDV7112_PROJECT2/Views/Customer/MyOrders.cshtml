@model IEnumerable<CLDV7112_PROJECT2.Models.OrderEntity>
@{
    ViewData["Title"] = "My Orders";
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h1 class="display-6 fw-bold"><span class="text-gradient">?? My Order History</span></h1>
        <p class="text-white-50">Your personal order history — only your orders are shown, secured by your Customer ID.</p>
    </div>
    <div class="col-auto">
        <a asp-controller="Customer" asp-action="Index" class="btn btn-glass btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Shop
        </a>
    </div>
</div>

<div class="glass-panel p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag-x display-3 text-muted d-block mb-3"></i>
            <h5 class="fw-semibold text-white">No Orders Placed Yet</h5>
            <p class="text-white-50 mb-4">You haven't placed any paid orders yet. Browse our catalogue to start shopping!</p>
            <a asp-controller="Customer" asp-action="Index" class="btn btn-rainbow">
                <i class="bi bi-cart-fill me-2"></i>Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th style="width:80px;">Product</th>
                        <th>Order Details</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Total Paid</th>
                        <th>Date</th>
                        <th class="text-center">Payment</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var payBadge = order.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark";
                        var statusBadge = order.Status switch
                        {
                            "Processing" => "bg-warning text-dark",
                            "Shipped" => "bg-info text-dark",
                            "Delivered" => "bg-success",
                            "Cancelled" => "bg-danger",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td>
                                <div class="rounded border border-secondary overflow-hidden bg-dark d-flex align-items-center justify-content-center" style="width:60px;height:60px;">
                                    @if (!string.IsNullOrEmpty(order.ImageUrl))
                                    {
                                        <img src="@order.ImageUrl" alt="@order.ProductName" style="width:100%;height:100%;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-box-seam text-muted fs-4"></i>
                                    }
                                </div>
                            </td>
                            <td>
                                <strong class="text-white d-block">@order.ProductName</strong>
                                <small class="text-white-50">Order ID: @order.RowKey.Substring(0, 8)...</small>
                                @if (!string.IsNullOrEmpty(order.PaymentIntentId))
                                {
                                    <small class="text-white-50 d-block">Ref: <code class="text-info" style="font-size:0.7rem;">@order.PaymentIntentId.Substring(0, 20)...</code></small>
                                }
                            </td>
                            <td class="text-center text-white">@order.Quantity</td>
                            <td class="text-end fw-bold text-price">R@(order.TotalAmount.ToString("F2"))</td>
                            <td><small class="text-white-50">@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td class="text-center"><span class="badge @payBadge">@order.PaymentStatus</span></td>
                            <td class="text-center"><span class="badge @statusBadge">@order.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
